# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/sahipark
# For production use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/sahipark

# ── JWT Auth ───────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
# For production: ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ── Email OTP (Gmail SMTP) ─────────────────────────────────────────────────────
# 1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
# 2. Generate App Password: https://myaccount.google.com/apppasswords
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_16_character_app_password

# ── Error Tracking (Sentry) ────────────────────────────────────────────────────
# Get free DSN from https://sentry.io (free tier: 5k errors/month)
# Leave empty to disable Sentry
SENTRY_DSN=
