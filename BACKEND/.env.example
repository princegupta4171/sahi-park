# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/sahipark
# For production use MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/sahipark

# ── JWT Auth ───────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173
# For production: ALLOWED_ORIGINS=https://your-frontend.vercel.app

# ── Email OTP (Resend API — replaces Gmail SMTP, works on Render free tier) ────
# Render blocks Gmail SMTP ports (465/587). Use Resend instead (3000 emails/month free).
# 1. Sign up at https://resend.com (free)
# 2. Go to API Keys → Create API Key
# 3. Paste it below
RESEND_API_KEY=re_your_resend_api_key_here

# ── SMS OTP (Fast2SMS) ─────────────────────────────────────────────────────────
# Get API key from: https://www.fast2sms.com/dashboard/dev-api
FAST2SMS_API_KEY=your_fast2sms_api_key_here


