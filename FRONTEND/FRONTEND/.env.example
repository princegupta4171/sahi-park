# Sahi-Park Frontend Environment Variables

# Backend API URL — REQUIRED for production deployment
# Local dev: leave blank (Vite proxy handles it automatically)
# Production (Vercel/Netlify): set to your Render backend URL
# Example: VITE_API_URL=https://sahi-park-backend.onrender.com
VITE_API_URL=

# Google Maps JavaScript API Key
# 1. Create a key in Google Cloud Console: https://console.cloud.google.com/
# 2. Enable "Maps JavaScript API" and "Geocoding API"
# 3. Replace YOUR_GOOGLE_MAPS_API_KEY_HERE with your key
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
